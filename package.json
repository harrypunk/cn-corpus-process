{
  "name": "chinese-peotry-process",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "etl": "bun src/index.ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test",
    "db:generate": "drizzle-kit generate",
    "db:generate:all": "DIALECT=sqlite drizzle-kit generate && DIALECT=postgresql drizzle-kit generate && DIALECT=mysql drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "mysql2": "^3.24.2",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
