# Copy to .env and adjust. Bun loads .env automatically.

# Source selection: fs (local checkout) or gitea (remote repo via HTTP API).
# ETL_SOURCE_KIND=fs

# --- fs source ---
# Required when ETL_SOURCE_KIND=fs: root of your local chinese-poetry checkout.
POETRY_ROOT=/path/to/chinese-poetry

# --- gitea source ---
# Required when ETL_SOURCE_KIND=gitea:
# GITEA_BASE_URL=https://gitea.example.com
# GITEA_OWNER=chinese-poetry
# GITEA_REPO=chinese-poetry
# Optional (defaults shown):
# GITEA_REF=master
# GITEA_TOKEN=               # only needed for private repos
# GITEA_PATH_PREFIX=         # limit listing to a subdirectory, e.g. 全唐诗
