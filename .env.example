# Copy to .env and adjust. Bun loads .env automatically.

# Required: root of your local chinese-poetry checkout.
POETRY_ROOT=/path/to/chinese-poetry

# Optional overrides (defaults shown):
# ETL_DB=dist/poetry.db
# ETL_REPORT=dist/report.json
# Run a single corpus instead of all (see README for source ids):
# ETL_SOURCE=shijing
