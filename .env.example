# Copy to .env and adjust. Bun loads .env automatically.

# Source selection: fs (local checkout) or gitea (remote repo via HTTP API).
# ETL_SOURCE_KIND=fs

# --- fs source ---
# Required when ETL_SOURCE_KIND=fs: root of your local chinese-poetry checkout.
POETRY_ROOT=/path/to/chinese-poetry

# --- gitea source ---
# Required when ETL_SOURCE_KIND=gitea:
# GITEA_BASE_URL=https://gitea.example.com
# GITEA_OWNER=chinese-poetry
# GITEA_REPO=chinese-poetry
# Optional (defaults shown):
# GITEA_REF=master
# GITEA_TOKEN=               # only needed for private repos

# --- listing filter (both sources) ---
# Comma-separated corpus dir prefixes; empty = the whole source.
# ETL_PATH_PREFIXES=全唐诗,元曲,五代诗词

# --- sink ---
# Sink selection: pglite (embedded Postgres, default) or tidb (MySQL protocol).
# ETL_SINK_KIND=pglite

# pglite sink (default shown):
# PGLITE_DATA_DIR=./dist/pglite

# tidb sink (required when ETL_SINK_KIND=tidb):
# DATABASE_URL=mysql://user:pass@host:4000/dbname
